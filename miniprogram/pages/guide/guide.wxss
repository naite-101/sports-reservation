/* 预约须知：四部分（馆内预约须知 / 规章制度 / 预排队制 / 时间表）+ 浅橙重点 */

.rule {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
  margin-bottom: 12rpx;
}

/* 重点条款：浅暖橙底、无边框、暖橙文字 */
.rule-highlight {
  background: #fdf1e7;
  color: #c0713c;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

/* 卡片标题内图标留白 */
.card-title--icon {
  display: flex;
  align-items: center;
}

.title-icon {
  margin-right: 10rpx;
}

/* 时间表分组 */
.table-group {
  margin-bottom: 20rpx;
}
.table-group:last-child {
  margin-bottom: 0;
}
.table-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
