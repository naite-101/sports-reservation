/* 建议 / 问题反馈：深校园绿主题 */

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 反馈内容多行输入 */
.feedback-textarea {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  background: #eaf6fd;
  border: 1rpx solid #f2f3f5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.placeholder {
  color: #b0b0b0;
}

/* 字数计数 */
.char-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}

/* 反馈类型标签 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  border: 1rpx solid transparent;
}

.type-item--active {
  color: #3557F2;
  background: #e3f2fc;
  border: 1rpx solid #3557F2;
}

/* 上传图片区域 */
.upload-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
  border-bottom-left-radius: 16rpx;
}

.add-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #eaf6fd;
  border: 1rpx dashed #c9d8cf;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-item--hover {
  background: #e3f2fc;
}

/* 提交按钮：橙色 */
.submit-btn {
  margin-top: 16rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: #ff7a00;
  border-radius: 32rpx;
  box-shadow: 0 4px 14px rgba(255, 122, 0, 0.28);
}

.submit-btn--hover {
  background: #e66e00;
}

/* 底部说明 */
.foot-tip {
  margin-top: 24rpx;
  padding: 0 12rpx 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}
