<view class="container qrcode-page">
  <view class="card qr-card">
    <view class="card-title qr-title">
      <line-icon custom-class="qr-title-icon" name="qrcode" size="32rpx" />个人身份二维码
    </view>
    <view class="qr-stage">
      <canvas canvas-id="qrcode" style="width: {{size}}px; height: {{size}}px; margin: 0 auto;"></canvas>
    </view>
    <view class="qr-tip">二维码 {{countdown}} 秒后自动刷新</view>
  </view>

  <view class="card booking-info-card" wx:if="{{hasValid}}">
    <view class="card-title qr-title">
      <line-icon custom-class="qr-title-icon" name="calendar" size="32rpx" />当前有效预约
    </view>
    <view class="info-row"><text class="info-label">场馆</text><text class="info-value">{{booking.venue_type_name}}</text></view>
    <view class="info-row"><text class="info-label">场地</text><text class="info-value">{{booking.court_no}} 号</text></view>
    <view class="info-row"><text class="info-label">场次</text><text class="info-value">{{booking.start_time}} ~ {{booking.end_time}}</text></view>
    <view class="info-row info-row--last"><text class="info-label">日期</text><text class="info-value">{{booking.date}}</text></view>
    <view class="qr-footnote">二维码定时刷新，截图不能签到</view>
  </view>
  <view class="card empty-card" wx:else>
    <t-empty description="当前无有效预约" />
    <view class="text-muted empty-guide">有效预约 = 今日场次开始前 15 分钟至结束</view>
    <view class="qr-footnote">二维码定时刷新，截图不能签到</view>
  </view>
</view>
