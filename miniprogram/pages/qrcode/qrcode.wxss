/* 动态二维码核销页：居中、留白、线性图标 */

.qrcode-page {
  text-align: center;
}

.qr-title {
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-title-icon {
  margin-right: 10rpx;
}

/* 二维码展示区：白色圆角容器（相对定位，供 loading 遮罩覆盖） */
.qr-stage {
  position: relative;
  background: #fff;
  border: 2rpx solid #eef0f2;
  border-radius: 24rpx;
  padding: 28rpx;
  display: inline-block;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
}

/* loading 遮罩：覆盖在 canvas 上，加载/刷新时消除空白卡顿 */
.qr-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  gap: 16rpx;
}

/* loading 旋转圈 */
.qr-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e3f2fc;
  border-top-color: #3557F2;
  border-radius: 50%;
  animation: qr-spin 0.8s linear infinite;
}

@keyframes qr-spin {
  to { transform: rotate(360deg); }
}

/* 倒计时刷新标签：浅暖橙 */
.qr-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #e8964b;
  background: #fdf1e7;
  border-radius: 999rpx;
  display: inline-block;
  padding: 10rpx 26rpx;
}

/* 有效预约信息卡 */
.booking-info-card {
  text-align: left;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 28rpx;
}

.info-row--last {
  border-bottom: none;
}

.info-label {
  color: #999;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.empty-card {
  text-align: center;
}

.empty-guide {
  margin-top: -8rpx;
  line-height: 1.6;
}

/* 底部小字提示 */
.qr-footnote {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b2b5;
}
