/* 首页视觉增强：网格场馆卡片 + 快捷入口 + 开放提示 */

/* 完善信息提示卡：浅绿点缀 */
.profile-tip-card {
  border-left: 8rpx solid #3557F2;
}

/* 区块标题 / 卡片标题左侧图标统一留白 */
.title-icon {
  margin-right: 10rpx;
}

.card-title--icon {
  display: flex;
  align-items: center;
}

/* ---------- 场馆网格 ---------- */
.venue-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.venue-card {
  width: 48.4%;
  background: #fff;
  border-radius: 32rpx;
  padding: 36rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  text-align: center;
  box-sizing: border-box;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.venue-card--hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6px 20px rgba(32, 117, 72, 0.10);
}

.venue-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 20rpx;
  background: #eaf6fd;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(53, 87, 242, 0.18);
}

.venue-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.venue-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 选择场馆标题右侧的预约简要信息（无预约时不显示） */
.section-title--split {
  justify-content: space-between;
}

.section-title-left {
  display: flex;
  align-items: center;
}

.reserve-brief {
  flex-shrink: 0;
  max-width: 62%;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 快捷入口 ---------- */
.entry-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.entry-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx 8rpx 28rpx;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.entry-card--hover {
  transform: translateY(-4rpx);
  box-shadow: 0 6px 20px rgba(32, 117, 72, 0.10);
}

.entry-icon {
  margin-bottom: 16rpx;
}

.entry-name {
  font-size: 26rpx;
  color: #444;
  font-weight: 500;
}

/* ---------- 底部开放提示（低饱和暖橙标签） ---------- */
.open-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fdf1e7;
  color: #e8964b;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 20rpx 24rpx;
  margin: 8rpx 0 24rpx;
}

/* ---------- 底部联合出品（两个社团 logo） ---------- */
.co-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 40rpx;
}

.co-brand-logos {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 48rpx;
}

.co-brand-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.co-brand-img {
  width: 128rpx;
  height: 128rpx;
}

.co-brand-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.co-brand-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #c0c4c8;
  letter-spacing: 4rpx;
}

/* ---------- 首页轮播 banner ---------- */
.banner-wrap {
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  background: #ffffff;
}

.banner-swiper {
  height: 320rpx;
}

.banner-img {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 32rpx;
}

/* ---------- 首页公告区（最近 3 条，含已读/未读） ---------- */
.notice-section {
  padding: 20rpx 28rpx 16rpx;
  margin-bottom: 8rpx;
}

.notice-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notice-section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.notice-section-more {
  font-size: 26rpx;
  color: #3557F2;
}

.notice-section-more--hover {
  opacity: 0.7;
}

.notice-section-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.notice-section-item--divider {
  border-top: 1rpx solid #f2f3f5;
}

.notice-section-item--hover {
  background: #fafbfc;
}

.notice-read-tag {
  flex-shrink: 0;
  width: 72rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
  border-radius: 8rpx;
  padding: 4rpx 0;
  margin-right: 18rpx;
}

.notice-read-tag--read {
  background: #3557F2;
  color: #ffffff;
}

.notice-read-tag--unread {
  background: #e34d59;
  color: #ffffff;
}

.notice-section-item-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.notice-section-item-date {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #999;
}
