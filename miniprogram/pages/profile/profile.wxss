/* 个人信息页补充样式 */

/* 锁定提示条：浅橙底 + 橙色文字，图标 + 提示 */
.lock-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fdf1e7;
  color: #c0713c;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

/* 锁定状态下输入框置灰 */
.form-input[disabled] {
  color: #999;
  background: #f5f6f7;
}
