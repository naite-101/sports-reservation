<view class="container">
  <view class="type-tabs" style="margin-bottom: 24rpx;">
    <t-tag t-class="tab-tag" theme="{{tab === 'admin' ? 'primary' : 'default'}}" variant="{{tab === 'admin' ? 'dark' : 'light'}}" data-tab="admin" bind:click="switchTab">管理员管理</t-tag>
    <t-tag t-class="tab-tag" theme="{{tab === 'student' ? 'primary' : 'default'}}" variant="{{tab === 'student' ? 'dark' : 'light'}}" data-tab="student" bind:click="switchTab" wx:if="{{myRole >= 3}}">成员信息</t-tag>
  </view>

  <!-- 管理员管理 -->
  <block wx:if="{{tab === 'admin'}}">
    <t-button theme="primary" block="{{true}}" bind:tap="toggleAdd">{{showAdd ? '收起' : '+ 任免管理员'}}</t-button>

    <view class="card" wx:if="{{showAdd}}">
      <view class="form-item">
        <view class="form-label">学号或姓名</view>
        <input class="form-input" value="{{adminForm.keyword}}" data-field="keyword" bindinput="onAdminInput" placeholder="输入学号或姓名" />
      </view>
      <view class="form-item">
        <view class="form-label">角色</view>
        <radio-group bindchange="onAdminInput" data-field="role">
          <label style="margin-right: 24rpx;"><radio value="2" checked="{{adminForm.role == 2}}" />普通管理员</label>
          <label style="margin-right: 24rpx;" wx:if="{{myRole >= 4}}"><radio value="3" checked="{{adminForm.role == 3}}" />超级管理员</label>
          <label wx:if="{{myRole >= 4}}"><radio value="4" checked="{{adminForm.role == 4}}" />人事管理员</label>
        </radio-group>
      </view>
      <view class="form-item">
        <view class="form-label">姓名（选填）</view>
        <input class="form-input" value="{{adminForm.name}}" data-field="name" bindinput="onAdminInput" placeholder="姓名" />
      </view>
      <t-button theme="primary" block="{{true}}" bind:tap="addAdmin">确认任免</t-button>
    </view>

    <view class="card" wx:for="{{admins}}" wx:key="_id">
      <view class="space-between">
        <text style="font-weight: 600;">{{item.name || item._id}}</text>
        <view>
          <t-tag size="small" theme="success" variant="light">{{item.roleText}}</t-tag>
          <t-tag size="small" theme="{{item.status === 1 ? 'success' : 'default'}}" variant="light" style="margin-left: 8rpx;">{{item.status === 1 ? '正常' : '已禁用'}}</t-tag>
        </view>
      </view>
      <view class="text-muted" style="margin-top: 8rpx;">{{item._id}}</view>
      <view class="row" style="justify-content: flex-end; gap: 12rpx; margin-top: 12rpx;" wx:if="{{item.role >= 2}}">
        <t-button size="small" theme="primary" variant="outline" data-openid="{{item._id}}" data-status="{{item.status}}" data-role="{{item.role}}" bind:tap="toggleStatus">{{item.status === 1 ? '禁用' : '启用'}}</t-button>
        <t-button size="small" theme="primary" variant="outline" data-openid="{{item._id}}" data-status="{{item.status}}" data-role="{{item.role}}" bind:tap="assignRole" wx:if="{{item.role < 4}}">{{roleUpLabel[item.role]}}</t-button>
        <t-button size="small" theme="danger" data-openid="{{item._id}}" bind:tap="removeAdmin" wx:if="{{myRole >= 4}}">移除</t-button>
      </view>
    </view>
  </block>

  <!-- 成员信息管理（学生 + 普通管理员） -->
  <block wx:if="{{tab === 'student'}}">
    <view class="card">
      <view class="row" style="gap: 16rpx;">
        <input class="form-input" style="flex:1;" value="{{keyword}}" bindinput="onKeyword" placeholder="按姓名/学号搜索学生或普通管理员" />
        <t-button size="small" bind:tap="search">搜索</t-button>
      </view>
    </view>

    <view class="card" wx:for="{{students}}" wx:key="_id">
      <view class="space-between">
        <text style="font-weight: 600;">{{item.name}}</text>
        <view>
          <t-tag size="small" theme="{{item.role === 2 ? 'warning' : 'primary'}}" variant="light">{{item.roleText}}</t-tag>
          <t-tag size="small" theme="primary" variant="light" data-openid="{{item._id}}" bind:click="editStudentTap" style="margin-left: 8rpx;">编辑</t-tag>
        </view>
      </view>
      <view class="text-muted" style="margin-top: 8rpx;">{{item.student_no}} · {{item.college}} · {{item.phone}}</view>
    </view>
    <t-empty wx:if="{{!students.length}}" description="暂无成员" />
  </block>

  <!-- 成员编辑弹层 -->
  <view class="card" wx:if="{{editStudent}}">
    <view class="card-title">编辑成员信息</view>
    <view class="form-item">
      <view class="form-label">姓名</view>
      <input class="form-input" value="{{studentForm.name}}" data-field="name" bindinput="onStudentInput" />
    </view>
    <view class="form-item">
      <view class="form-label">学号</view>
      <input class="form-input" value="{{studentForm.student_no}}" data-field="student_no" bindinput="onStudentInput" />
    </view>
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" value="{{studentForm.phone}}" data-field="phone" bindinput="onStudentInput" />
    </view>
    <view class="form-item">
      <view class="form-label">学院</view>
      <input class="form-input" value="{{studentForm.college}}" data-field="college" bindinput="onStudentInput" />
    </view>
    <view class="row" style="gap: 16rpx;">
      <t-button theme="primary" variant="outline" style="flex:1;" bind:tap="cancelEdit">取消</t-button>
      <t-button theme="primary" style="flex:1;" bind:tap="saveStudent">保存</t-button>
    </view>
  </view>
</view>
