/* 场地管理（管理后台）—— 浅色主题、品牌蓝 #3557F2 */

.container {
  padding: 24rpx 24rpx 48rpx;
}

.page-loading {
  padding: 160rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #a8aeb8;
}

/* ---------------- 顶部概览 ---------------- */

.hero {
  background: linear-gradient(135deg, #3557f2 0%, #5b7cff 100%);
  border-radius: 32rpx;
  padding: 32rpx 28rpx 12rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(53, 87, 242, 0.22);
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.78);
}

.date-chip {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  font-size: 22rpx;
  color: #ffffff;
}

.stat-row {
  display: flex;
  align-items: stretch;
  margin-top: 28rpx;
}

.stat {
  flex: 1;
  text-align: center;
  padding: 8rpx 0 20rpx;
  position: relative;
}

.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 20rpx;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.22);
}

.stat-num {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ---------------- 操作区 ---------------- */

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-main {
  flex: 1;
}

.action-refresh {
  flex-shrink: 0;
}

/* ---------------- 场馆筛选 ---------------- */

.type-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.type-tabs-inline {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 2rpx 12rpx;
}

.type-chip {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #666;
  font-size: 26rpx;
  border: 1rpx solid #eceef2;
  transition: all 0.15s ease;
}

.type-chip--active {
  background: #3557f2;
  border-color: #3557f2;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(53, 87, 242, 0.24);
}

/* ---------------- 区块标题 + 图例 ---------------- */

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 16rpx;
}

.section-head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.legend-dot--main {
  background: #3557f2;
}

.legend-dot--onsite {
  background: #b9bec7;
}

.legend-dot--admin {
  background: #e8964b;
}

.legend-text {
  font-size: 20rpx;
  color: #98a0ab;
  margin-right: 6rpx;
}

/* ---------------- 签到卡片 ---------------- */

.record-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.main-badge {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e3f2fc;
  color: #3557f2;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.main-info {
  flex: 1;
  min-width: 0;
}

.main-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.main-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.main-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b93a1;
}

.record-time {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #3557f2;
  font-weight: 600;
}

.record-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
}

.meta-sep {
  color: #d5d9e0;
}

/* ---------------- 人员列表 ---------------- */

.people {
  margin-top: 16rpx;
  background: #fafbfc;
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
}

.person-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #e9ecf1;
}

.person-row:last-child {
  border-bottom: none;
}

.person-main {
  flex: 1;
  min-width: 0;
}

.person-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.person-line--sub {
  margin-top: 4rpx;
}

.person-name {
  font-size: 26rpx;
  color: #333;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-sub {
  font-size: 21rpx;
  color: #98a0ab;
}

.person-dot {
  font-size: 21rpx;
  color: #c8ced8;
}

.person-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8aeb8;
}

.person-del {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #d9534f;
  padding: 4rpx 0 4rpx 12rpx;
}

.people-empty {
  padding: 14rpx 0;
  font-size: 23rpx;
  color: #a8aeb8;
}

/* ---------------- 状态标签 ---------------- */

.pill {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1;
  flex-shrink: 0;
}

.pill--main {
  background: #e3f2fc;
  color: #3557f2;
}

.pill--onsite {
  background: #f0f2f5;
  color: #6b7280;
}

.pill--admin {
  background: #fdf1e7;
  color: #c0713c;
}

.pill--ok {
  background: #e7f7ee;
  color: #1f9d55;
}

.pill--danger {
  background: #fdecea;
  color: #d9534f;
}

.pill--muted {
  background: #f0f2f5;
  color: #9aa0a6;
}

/* ---------------- 卡片底部操作 ---------------- */

.record-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
}

.link-btn {
  font-size: 25rpx;
  color: #3557f2;
  padding: 6rpx 2rpx;
}

.link-btn--scan {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.link-btn--danger {
  color: #d9534f;
}

.link-btn--muted {
  color: #9aa0a6;
  font-size: 23rpx;
}

.bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c0;
  padding: 12rpx 0 8rpx;
  line-height: 1.6;
}

/* ---------------- 后台签到抽屉 ---------------- */

.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 900;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  height: 82vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: sheet-up 0.22s ease-out;
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e6e8ec;
  margin: 4rpx auto 18rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b93a1;
}

.sheet-close {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8b93a1;
  padding: 6rpx 8rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 0 8rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.search-btn {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #eaf0ff;
  color: #3557f2;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.sheet-body {
  flex: 1;
  height: 0;
}

.pending-tip {
  font-size: 22rpx;
  color: #8b93a1;
  padding: 12rpx 2rpx;
}

.pending-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #222;
}

.pending-no {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98a0ab;
}

.pending-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7c8494;
}

.pending-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.sheet-status {
  text-align: center;
  font-size: 24rpx;
  color: #a8aeb8;
  padding: 32rpx 0;
}

.sheet-spacer {
  height: 24rpx;
}

/* ---------------- 弹窗（补录 / 拉黑） ---------------- */

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 950;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  animation: modal-in 0.18s ease-out;
}

@keyframes modal-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.modal-sub {
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  font-size: 23rpx;
  color: #8b93a1;
  line-height: 1.5;
}

.modal .form-item {
  margin-bottom: 20rpx;
}

.modal .form-input {
  box-sizing: border-box;
  height: 84rpx;
  background: #f7f8fa;
  border: 1rpx solid #e9ecf1;
}

.quick-days {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.quick-day {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #666;
  font-size: 23rpx;
}

.quick-day--active {
  background: #eaf0ff;
  color: #3557f2;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.modal-btn-wrap {
  flex: 1;
}
