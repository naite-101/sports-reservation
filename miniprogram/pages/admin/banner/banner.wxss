.banner-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.banner-item:last-child {
  border-bottom: none;
}

.banner-thumb {
  width: 160rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.banner-info {
  flex: 1;
  min-width: 0;
}

.banner-order {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.banner-ops {
  display: flex;
  gap: 16rpx;
}

.op-btn {
  font-size: 24rpx;
  color: #3557F2;
  padding: 8rpx 20rpx;
  border: 1rpx solid #3557F2;
  border-radius: 999rpx;
}

.op-btn--danger {
  color: #d9534f;
  border-color: #d9534f;
}
