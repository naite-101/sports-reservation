.court-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.court {
  width: 21%;
  background: #eaf6fd;
  color: #3557F2;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
}

.court.closed {
  background: #fdecea;
  color: #d9534f;
}

.court-status {
  font-size: 20rpx;
  margin-top: 6rpx;
}

.closed-until {
  font-size: 18rpx;
  color: #e8964b;
  margin-top: 2rpx;
}

.op-btn {
  margin-top: 12rpx;
  font-size: 22rpx;
  text-decoration: underline;
}
