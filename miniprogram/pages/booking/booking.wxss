/* 选择场地：自定义标签 + 三态场地格 + 深绿提交按钮 */

/* 卡片标题内图标留白 */
.card-title--icon {
  display: flex;
  align-items: center;
}

.title-icon {
  margin-right: 10rpx;
}

/* 场馆 / 场次切换标签 */
.type-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 未选中：浅蓝底 + 蓝色文字；选中：深蓝卡片 + 白字 + 右上角对勾（与「选择场地」一致） */
.chip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  background: #eaf6fd;
  color: #3557F2;
  border: 2rpx solid #eaf6fd;
  border-radius: 16rpx;
  padding: 22rpx 30rpx;
  font-size: 26rpx;
  line-height: 1;
  box-sizing: border-box;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.chip--active {
  background: #3557F2;
  color: #ffffff;
  border-color: #3557F2;
  font-weight: 600;
}

.chip-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.court-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

/* 场地格子：三态配色清晰区分 */
.court {
  position: relative;
  width: 21.5%;
  background: #eaf6fd;
  color: #3557F2;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 26rpx;
  box-sizing: border-box;
  transition: transform 0.12s ease;
}

/* 可预约：浅绿底 */
.court.available {
  background: #eaf6fd;
  color: #3557F2;
}

/* 已约满：浅灰底灰字 */
.court.booked {
  background: #f0f1f2;
  color: #9aa0a6;
}

/* 闭馆：更深灰 */
.court.closed {
  background: #e3e5e8;
  color: #8b8f94;
}

/* 选中态：加深底色 + 白色对勾 */
.court.selected {
  background: #3557F2;
  color: #fff;
  font-weight: 600;
  transform: translateY(-2rpx);
}

.court-no {
  line-height: 1;
}

.court-status {
  font-size: 20rpx;
  margin-top: 10rpx;
}

.court-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

/* 提交预约按钮：可预约深绿，否则柔和灰（通过 t-class 覆盖 TDesign 默认样式） */
.submit-btn--active {
  border-radius: 16rpx !important;
  height: 88rpx !important;
  font-weight: 600 !important;
  background-color: #3557F2 !important;
  border-color: #3557F2 !important;
  color: #fff !important;
}

.submit-btn--disabled {
  border-radius: 16rpx !important;
  height: 88rpx !important;
  font-weight: 600 !important;
  background-color: #d8dadc !important;
  border-color: #d8dadc !important;
  color: #fff !important;
}

/* 底部预约提示 */
.booking-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
}

/* 人机验证码弹窗 */
.captcha-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.captcha-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
}

.captcha-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.captcha-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9aa0a6;
  text-align: center;
}

.captcha-question-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.captcha-question {
  font-size: 44rpx;
  font-weight: 700;
  color: #3557F2;
  letter-spacing: 4rpx;
}

.captcha-refresh {
  font-size: 24rpx;
  color: #3557F2;
  text-decoration: underline;
}

.captcha-input {
  margin-top: 28rpx;
  height: 84rpx;
  background: #f4f6f8;
  border: 2rpx solid #e3e5e8;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.captcha-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.captcha-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.captcha-btn--cancel {
  background: #f0f1f2;
  color: #666;
}

.captcha-btn--ok {
  background: #3557F2;
  color: #fff;
}
