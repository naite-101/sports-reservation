<view class="container">
  <view class="card-title">预约记录</view>
  <view class="card" wx:for="{{records}}" wx:key="res_id">
    <view class="space-between">
      <text style="font-weight: 600;">{{item.venue_type_name}} {{item.court_no}}号</text>
      <t-tag size="small" theme="{{item.status === 'pending' ? 'success' : 'default'}}" variant="light">{{item.statusText}}</t-tag>
    </view>
    <view class="text-muted" style="margin-top: 8rpx;">{{item.date}} {{item.slot_key}}</view>
  </view>
  <t-empty wx:if="{{!records.length}}" description="暂无预约记录" />

  <view class="card-title" style="margin-top: 24rpx;">签到记录</view>
  <view class="card" wx:for="{{checkins}}" wx:key="res_id">
    <view class="space-between">
      <text style="font-weight: 600;">{{item.venue_type_name}} {{item.court_no}}号</text>
      <t-tag size="small" theme="success" variant="light">已签到</t-tag>
    </view>
    <view class="text-muted" style="margin-top: 8rpx;">{{item.date}} {{item.slot_key}} 签到于 {{item.checkinTimeText}}</view>
    <view class="text-muted" wx:if="{{item.companions.length}}">附属：{{item.companionsText}}</view>
  </view>
  <t-empty wx:if="{{!checkins.length}}" description="暂无签到记录" />
</view>
